{
  "consumer": {
    "name": "laa-court-data-adaptor"
  },
  "interactions": [
    {
      "description": "a request to validate a MAAT reference",
      "pending": false,
      "providerStates": [
        {
          "name": "a MAAT reference that has no common platform data"
        }
      ],
      "request": {
        "body": {
          "content": {
            "caseUrn": "XYZ",
            "maatId": "1234567"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "any"
          ],
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.caseUrn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "(?-mix:.*)"
                }
              ]
            },
            "$.maatId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "(?-mix:\\A[0-9]{7}\\z)"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "(?-mix:.*)"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/link/validate"
      },
      "response": {
        "body": {
          "content": {
            "code": "BAD_REQUEST",
            "message": "1234567 has no common platform data created against Maat application."
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 400
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
